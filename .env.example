# Copiez ce fichier en ".env" et remplissez les vraies valeurs.
# Ne JAMAIS committer le fichier ".env" réel dans Git.

# Clé secrète Flask (générez une valeur aléatoire, ex: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-moi

# URL de connexion PostgreSQL fournie par Neon ou Aiven
# Exemple Neon   : postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require
# Exemple Aiven  : postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
